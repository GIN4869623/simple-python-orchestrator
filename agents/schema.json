{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "智能体能力摘要",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_id",
    "name",
    "description",
    "capabilities"
  ],
  "properties": {
    "agent_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "required_inputs": {
            "$ref": "#/$defs/stringList"
          },
          "constraints": {
            "$ref": "#/$defs/stringList"
          }
        }
      }
    },
    "constraints": {
      "$ref": "#/$defs/stringList"
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
