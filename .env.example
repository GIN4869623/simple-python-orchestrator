# Copy this file to .env, then replace the values with your local deployment.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=<your-local-model-name>
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.2
OLLAMA_LOG_PATH=logs/ollama_responses.json
ORCHESTRATOR_AGENT_LOG_PATH=logs/agent_messages.jsonl

# Fake backends
FAKE_DEVICE_ID=USRP-01

# Orchestrator behavior and decision limits
ORCHESTRATOR_PARAMETER_POLICY=demo_defaults
ORCHESTRATOR_ENABLE_AGENT_REGISTRY=0
ORCHESTRATOR_MAX_RETRIES=1
ORCHESTRATOR_MAX_REPLANS=1

# Orchestration service for the frontend (./serve or ./serve-orchestrator).
# Replace this example IP with your server LAN IP.
ORCHESTRATOR_API_HOST=192.168.1.106
# ORCHESTRATOR_API_PORT=18002
# ORCHESTRATOR_API_TOKEN=<a-long-random-token-shared-with-the-Next.js-server>

# Independent intent service (./serve-intent), called over HTTP by orchestration.
INTENT_API_HOST=192.168.1.106
INTENT_API_PORT=18003
INTENT_SERVICE_URL=http://192.168.1.106:18003
# Both services reuse ORCHESTRATOR_API_TOKEN unless INTENT_API_TOKEN is set.
# INTENT_API_TOKEN=<a-separate-token-shared-between-these-two-services>
# INTENT_SERVICE_TIMEOUT=180
# Intent recognition can use a different model; unset values reuse OLLAMA_*.
# INTENT_BACKEND=ollama
# INTENT_OLLAMA_BASE_URL=http://localhost:11434
# INTENT_OLLAMA_MODEL=<your-intent-model-name>
# INTENT_OLLAMA_TIMEOUT=120
# INTENT_OLLAMA_TEMPERATURE=0.2
INTENT_OLLAMA_LOG_PATH=logs/intent_responses.json

# Enable just the real knowledge HTTP JSON service (other agents remain Fake).
# Alternatively, pass --knowledge-api-url without a value to use this address.
# KNOWLEDGE_API_URL=http://192.168.1.103:18001/api/knowledge/answer
# Sent as the X-Knowledge-API-Key request header.
# KNOWLEDGE_API_KEY=<your-knowledge-api-key>

# Independent read-only network supervision for both intent and orchestration.
# NETWORK_SUPERVISION_CHAT_URL=http://192.168.1.116:3000/api/agent/messages
# NETWORK_SUPERVISION_CHAT_TIMEOUT=120

# JSON-RPC addresses used with --remote-agents. Real hardware requires strict parameter policy.
# KNOWLEDGE_API_URL takes precedence over KNOWLEDGE_RPC_URL when configured.
# NETWORK_SUPERVISION_CHAT_URL takes precedence over DEVICE_MANAGER_RPC_URL when configured.
# KNOWLEDGE_RPC_URL=http://knowledge-host:8000/rpc
# DEVICE_MANAGER_RPC_URL=http://device-host:8000/rpc
# USRP_RPC_URL=http://usrp-host:8000/rpc
# ORCHESTRATOR_RPC_TIMEOUT=30
# ORCHESTRATOR_RPC_TOKEN=<shared-secret>

# Intent entry dispatches only complex requests to this service.
ORCHESTRATION_SERVICE_URL=http://192.168.1.106:18002
# ORCHESTRATION_SERVICE_TIMEOUT=600

# RIS 文字任务接口（在意图识别 / 编排结果中显示回复）
RIS_AGENT_CHAT_URL=http://192.168.1.132:8000/api/chat/stream
RIS_AGENT_TIMEOUT=180

# Intent and orchestration select providers independently; local remains the default.
MODEL_PROVIDER=ollama
INTENT_MODEL_PROVIDER=ollama
ORCHESTRATOR_MODEL_PROVIDER=ollama
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_API_KEY=<configure-only-on-the-backend>
DEEPSEEK_TIMEOUT=120
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_TOKENS=8192
DEEPSEEK_REASONING_EFFORT=none
# Optional existing HTTP CONNECT proxy; applies only to DeepSeek calls.
# DEEPSEEK_PROXY_URL=http://127.0.0.1:7897
# INTENT_DEEPSEEK_MODEL=deepseek-flash
# INTENT_DEEPSEEK_BASE_URL=https://api.deepseek.com
# INTENT_DEEPSEEK_API_KEY=<optional-independent-key>
# ORCHESTRATOR_DEEPSEEK_API_KEY=<optional-independent-key>
